<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface"
    android:orientation="vertical">

    <!-- Top Bar: Back button, Progress Dots, Skip -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp">

        <ImageButton
            android:id="@+id/btnOnboardingBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Back"
            android:src="@drawable/ic_arrow_back"
            android:visibility="invisible"
            app:tint="@color/icon_tint" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingHorizontal="12dp">

            <TextView
                android:id="@+id/tvStepCounter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Step 1 of 7"
                android:textColor="@color/text_secondary"
                android:textSize="13sp"
                android:fontFamily="sans-serif-medium" />

            <!-- Progress Bar -->
            <com.google.android.material.progressindicator.LinearProgressIndicator
                android:id="@+id/onboardingProgress"
                android:layout_width="140dp"
                android:layout_height="4dp"
                android:layout_marginTop="6dp"
                android:max="7"
                android:progress="1"
                app:indicatorColor="@color/primary"
                app:trackColor="@color/card_stroke"
                app:trackCornerRadius="2dp" />
        </LinearLayout>

        <TextView
            android:id="@+id/btnOnboardingSkip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:padding="8dp"
            android:text="Skip"
            android:textColor="@color/primary"
            android:textSize="15sp"
            android:fontFamily="sans-serif-medium" />
    </LinearLayout>

    <!-- Scrollable Step Content -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:clipToPadding="false">

        <LinearLayout
            android:id="@+id/stepContentContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="32dp"
            android:paddingBottom="24dp">

            <!-- Hero Icon in a large curved container -->
            <FrameLayout
                android:id="@+id/layoutHeroIcon"
                android:layout_width="88dp"
                android:layout_height="88dp"
                android:layout_gravity="center_horizontal"
                android:background="@drawable/bg_onboarding_hero">

                <ImageView
                    android:id="@+id/ivHeroIcon"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_gravity="center"
                    android:contentDescription="Step Icon"
                    android:src="@drawable/ic_bridge_logo" />
            </FrameLayout>

            <!-- Step Title – Large and bold like Apple's setup screens -->
            <TextView
                android:id="@+id/tvStepTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:gravity="center"
                android:paddingHorizontal="32dp"
                android:textColor="@color/text_primary"
                android:textSize="28sp"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="-0.02"
                tools:text="Welcome to Bridge" />

            <!-- Step Subtitle -->
            <TextView
                android:id="@+id/tvStepSubtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center"
                android:lineSpacingExtra="4dp"
                android:paddingHorizontal="40dp"
                android:textColor="@color/text_secondary"
                android:textSize="15sp"
                tools:text="Seamless cross-device connectivity between your Android phone and Mac." />

            <!-- Interactive Guidance Card – Rounded with generous padding -->
            <LinearLayout
                android:id="@+id/cardStepGuidance"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:layout_marginHorizontal="20dp"
                android:background="@drawable/bg_onboarding_card"
                android:orientation="vertical"
                android:padding="20dp">

                <!-- Status Header Row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tvGuidanceTitle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="System Setup"
                        android:textColor="@color/text_primary"
                        android:textSize="15sp"
                        android:fontFamily="sans-serif-medium" />

                    <!-- Status Pill Badge -->
                    <LinearLayout
                        android:id="@+id/badgeStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_pill"
                        android:backgroundTint="@color/pill_orange_bg"
                        android:gravity="center"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="4dp">

                        <TextView
                            android:id="@+id/tvStatusBadge"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Action needed"
                            android:textColor="@color/status_orange"
                            android:textSize="12sp"
                            android:fontFamily="sans-serif-medium" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Guidance Steps Instruction Text -->
                <TextView
                    android:id="@+id/tvGuidanceInstructions"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:lineSpacingExtra="5dp"
                    android:textColor="@color/text_secondary"
                    android:textSize="14sp"
                    tools:text="1. Tap Open Accessibility Settings below\n2. Find Bridge in Downloaded apps\n3. Switch ON and tap Allow" />

                <!-- Secondary Extra Info -->
                <LinearLayout
                    android:id="@+id/layoutGuidanceExtra"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:background="@drawable/bg_onboarding_inset"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="14dp">

                    <ImageView
                        android:id="@+id/ivGuidanceExtraIcon"
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:contentDescription="Info"
                        android:src="@drawable/ic_info"
                        app:tint="@color/text_tertiary" />

                    <TextView
                        android:id="@+id/tvGuidanceExtraText"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:layout_weight="1"
                        android:lineSpacingExtra="3dp"
                        android:textColor="@color/text_secondary"
                        android:textSize="13sp"
                        tools:text="Bridge only reads data you copy to mirror it to your Mac. No personal data is stored." />
                </LinearLayout>
            </LinearLayout>

            <!-- Spacer to push buttons down on taller screens -->
            <View
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:minHeight="28dp" />

            <!-- Primary Action Button – Large, full-width, iOS-style continuous pill -->
            <Button
                android:id="@+id/btnPrimaryAction"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="20dp"
                android:layout_marginHorizontal="20dp"
                android:background="@drawable/bg_onboarding_button_primary"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="17sp"
                android:fontFamily="sans-serif-medium"
                tools:text="Get Started" />

            <!-- Secondary Action Button -->
            <Button
                android:id="@+id/btnSecondaryAction"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="10dp"
                android:layout_marginHorizontal="20dp"
                android:background="@drawable/bg_onboarding_button_secondary"
                android:textAllCaps="false"
                android:textColor="@color/text_primary"
                android:textSize="15sp"
                android:fontFamily="sans-serif"
                tools:text="I don't want to receive notification" />

            <!-- Optional Alternative Action -->
            <TextView
                android:id="@+id/btnAlternativeAction"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="14dp"
                android:background="?attr/selectableItemBackground"
                android:padding="10dp"
                android:textColor="@color/primary"
                android:textSize="14sp"
                android:fontFamily="sans-serif-medium"
                android:visibility="gone"
                tools:text="Or pair manually with 6-digit code" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</LinearLayout>
