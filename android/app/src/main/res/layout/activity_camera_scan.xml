<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <!-- Camera Preview -->
    <androidx.camera.view.PreviewView
        android:id="@+id/previewView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Overlay & Viewfinder Container -->
    <RelativeLayout
        android:id="@+id/scannerOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- Top Scrim -->
        <View
            android:id="@+id/scrimTop"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_alignParentTop="true"
            android:layout_above="@id/viewfinderBox"
            android:background="#99000000" />

        <!-- Bottom Scrim -->
        <View
            android:id="@+id/scrimBottom"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_alignParentBottom="true"
            android:layout_below="@id/viewfinderBox"
            android:background="#99000000" />

        <!-- Left Scrim -->
        <View
            android:id="@+id/scrimLeft"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_alignParentStart="true"
            android:layout_toStartOf="@id/viewfinderBox"
            android:layout_alignTop="@id/viewfinderBox"
            android:layout_alignBottom="@id/viewfinderBox"
            android:background="#99000000" />

        <!-- Right Scrim -->
        <View
            android:id="@+id/scrimRight"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_alignParentEnd="true"
            android:layout_toEndOf="@id/viewfinderBox"
            android:layout_alignTop="@id/viewfinderBox"
            android:layout_alignBottom="@id/viewfinderBox"
            android:background="#99000000" />

        <!-- Viewfinder Center Window (260dp x 260dp) -->
        <FrameLayout
            android:id="@+id/viewfinderBox"
            android:layout_width="260dp"
            android:layout_height="260dp"
            android:layout_centerInParent="true">

            <!-- Corner 1: Top-Left -->
            <ImageView
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_gravity="top|start"
                android:contentDescription="Corner"
                android:src="@drawable/ic_qr_corner_bracket" />

            <!-- Corner 2: Top-Right -->
            <ImageView
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_gravity="top|end"
                android:rotation="90"
                android:contentDescription="Corner"
                android:src="@drawable/ic_qr_corner_bracket" />

            <!-- Corner 3: Bottom-Right -->
            <ImageView
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_gravity="bottom|end"
                android:rotation="180"
                android:contentDescription="Corner"
                android:src="@drawable/ic_qr_corner_bracket" />

            <!-- Corner 4: Bottom-Left -->
            <ImageView
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_gravity="bottom|start"
                android:rotation="270"
                android:contentDescription="Corner"
                android:src="@drawable/ic_qr_corner_bracket" />

            <!-- Scanning Laser Line -->
            <View
                android:id="@+id/scanningLine"
                android:layout_width="match_parent"
                android:layout_height="2dp"
                android:layout_gravity="top"
                android:background="@color/primary" />
        </FrameLayout>

    </RelativeLayout>

    <!-- Top Navigation & Controls Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_gravity="top"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp">

        <ImageButton
            android:id="@+id/btnScannerClose"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Close"
            android:src="@drawable/ic_close"
            app:tint="#FFFFFF" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:text="Scan Bridge QR"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold" />

        <ImageButton
            android:id="@+id/btnTorch"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Toggle Flashlight"
            android:src="@drawable/ic_flash_off"
            app:tint="#FFFFFF" />
    </LinearLayout>

    <!-- Bottom Guidance & Manual Fallback -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingHorizontal="24dp"
        android:paddingBottom="40dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:lineSpacingExtra="2dp"
            android:text="Point camera at the QR code shown in Bridge on your Mac"
            android:textColor="#FFFFFF"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/tvScannerStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:text="Searching for Bridge QR…"
            android:textColor="#A0C2FF"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Permission Needed View (if camera not allowed) -->
    <LinearLayout
        android:id="@+id/permissionDeniedContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/surface"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="28dp"
        android:visibility="gone">

        <ImageView
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:contentDescription="Camera"
            android:src="@drawable/ic_camera"
            app:tint="@color/primary" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Camera Permission Required"
            android:textColor="@color/text_primary"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:text="Bridge uses your camera to scan the pairing QR code from your Mac."
            android:textColor="@color/text_secondary"
            android:textSize="14sp" />

        <Button
            android:id="@+id/btnRequestCameraPermission"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="24dp"
            android:background="@drawable/bg_button_primary"
            android:text="Grant Camera Access"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnCancelScanner"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_button_outline"
            android:text="Cancel"
            android:textAllCaps="false"
            android:textColor="@color/text_primary"
            android:textSize="15sp" />
    </LinearLayout>

</FrameLayout>
