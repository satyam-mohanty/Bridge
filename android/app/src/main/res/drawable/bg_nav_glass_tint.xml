<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Base frosted glass fill with crisp detectable outer boundary -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="100dp" />
            <gradient
                android:angle="270"
                android:startColor="@color/nav_glass_top"
                android:endColor="@color/nav_glass_bottom" />
            <stroke
                android:width="1dp"
                android:color="@color/nav_glass_stroke" />
        </shape>
    </item>
    <!-- Inner specular refraction highlight along the curved glass bevel -->
    <item
        android:left="1dp"
        android:top="1dp"
        android:right="1dp"
        android:bottom="1dp">
        <shape android:shape="rectangle">
            <corners android:radius="100dp" />
            <stroke
                android:width="1dp"
                android:color="@color/nav_glass_inner_glow" />
            <solid android:color="@android:color/transparent" />
        </shape>
    </item>
</layer-list>
